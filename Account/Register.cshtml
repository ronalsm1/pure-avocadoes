@model PureAvocadoes.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="mx-auto w-full max-w-[30rem] py-6" aria-labelledby="register-heading">
    <div class="card rounded-card p-6 text-center md:p-8">
        <div class="mb-3 flex justify-center" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 32 32" fill="none">
                <path d="M16 3C11.2 3 7 10.6 7 18.2C7 24.4 10.9 29 16 29C21.1 29 25 24.4 25 18.2C25 10.6 20.8 3 16 3Z" fill="#718D43" stroke="#1F3D2A" stroke-width="1.2" />
                <circle cx="16" cy="19.5" r="4.8" fill="#D6AC55" stroke="#1F3D2A" stroke-width="1.2" />
            </svg>
        </div>

        <h1 id="register-heading" class="mb-1 text-xl font-bold">Discover something fresh</h1>
        <p class="mb-6 text-sm text-ink-muted">Create your free account to rate movies from 1 to 5 and publish reviews.</p>

        <form asp-action="Register" method="post" novalidate class="text-left">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="FullName" class="field-label"></label>
                <input asp-for="FullName" class="field" autocomplete="name" placeholder="Full name" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="field-label"></label>
                <input asp-for="Email" class="field" autocomplete="email" inputmode="email" placeholder="Email address" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="field-label"></label>
                <div class="relative">
                    <input asp-for="Password" class="field pr-11" autocomplete="new-password" aria-describedby="password-help" placeholder="Password" data-password-input />
                    <button type="button"
                            class="absolute right-1 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-control text-ink-muted transition-colors duration-150 hover:bg-paper-muted hover:text-ink"
                            data-password-toggle aria-label="Show password" aria-pressed="false">
                        <svg class="pa-eye-icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg class="pa-eye-icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                </div>
                <p id="password-help" class="mt-1 text-xs text-ink-muted">Use at least 8 characters.</p>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="field-label"></label>
                <div class="relative">
                    <input asp-for="ConfirmPassword" class="field pr-11" autocomplete="new-password" placeholder="Confirm password" data-password-input />
                    <button type="button"
                            class="absolute right-1 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-control text-ink-muted transition-colors duration-150 hover:bg-paper-muted hover:text-ink"
                            data-password-toggle aria-label="Show password" aria-pressed="false">
                        <svg class="pa-eye-icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg class="pa-eye-icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-block btn-primary">Continue</button>
        </form>

        <p class="mt-4 text-xs text-ink-muted">
            By joining, you agree to the <a class="font-semibold text-avocado-500 underline underline-offset-2 hover:text-avocado-900" asp-controller="Home" asp-action="Privacy">Privacy Policy</a> of Pure Avocadoes.
        </p>

        <p class="mt-3 text-sm text-ink-muted">
            Already have an account?
            <a class="font-semibold text-avocado-500 underline underline-offset-2 hover:text-avocado-900" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

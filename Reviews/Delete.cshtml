@model PureAvocadoes.ViewModels.ReviewDeleteViewModel
@{
    ViewData["Title"] = "Delete Review";
}

<nav class="mb-5 flex flex-wrap items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
    <a class="font-semibold text-avocado-500 hover:text-avocado-900" asp-controller="Reviews" asp-action="Mine">My Reviews</a>
    <span aria-hidden="true">/</span>
    <a class="font-semibold text-avocado-500 hover:text-avocado-900" href="/Movies/Details/@Model.MovieId">@Model.MovieTitle</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink">Delete Review</span>
</nav>

<section class="mx-auto w-full max-w-2xl" aria-labelledby="delete-review-heading">
    <div class="card">
        <header class="mb-5 border-b border-line pb-4">
            <p class="kicker text-danger-fg">Confirm Removal</p>
            <h1 id="delete-review-heading" class="mt-1 text-xl font-bold">Delete Review</h1>
            <p class="mt-1 text-sm text-ink-muted">
                Removing this review will take it off <strong class="text-ink">@Model.MovieTitle</strong> and recalculate the Avocado Score.
            </p>
        </header>

        <dl class="mb-4 divide-y divide-line">
            <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-3 py-2">
                <dt class="text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted">Movie</dt>
                <dd class="text-sm">@Model.MovieTitle</dd>
            </div>
            <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-3 py-2">
                <dt class="text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted">Your Rating</dt>
                <dd class="text-sm tabular-nums">@Model.Rating / 5</dd>
            </div>
            <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-3 py-2">
                <dt class="text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted">Date</dt>
                <dd class="text-sm">@(Model.IsEdited ? $"Updated {Model.FormattedDate}" : Model.FormattedDate)</dd>
            </div>
        </dl>

        <div class="mb-5 rounded-card border border-line bg-paper-alt p-4">
            <p class="text-sm leading-relaxed text-ink">@Model.ReviewText</p>
        </div>

        <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@Model.ReviewId" method="post">
            @Html.AntiForgeryToken()

            <div class="flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a class="btn btn-secondary" asp-controller="Reviews" asp-action="Mine">Cancel</a>
            </div>
        </form>
    </div>
</section>

{
  "name": "pure-avocadoes",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend asset pipeline for Pure Avocadoes (ASP.NET Core MVC). Tailwind compiles Styles/app.css into wwwroot/css/site.css.",
  "scripts": {
    "css:build": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/site.css --minify",
    "css:watch": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/site.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronalsm1/pure-avocadoes.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ronalsm1/pure-avocadoes/issues"
  },
  "homepage": "https://github.com/ronalsm1/pure-avocadoes#readme",
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19"
  }
}

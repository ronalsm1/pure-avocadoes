@model PureAvocadoes.ViewModels.MovieFormViewModel
@{
    ViewData["Title"] = "Edit Movie";
}

<nav class="mb-5 flex flex-wrap items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
    <a class="font-semibold text-avocado-500 hover:text-avocado-900" asp-controller="AdminMovies" asp-action="Index">Manage Movies</a>
    <span aria-hidden="true">/</span>
    <a class="font-semibold text-avocado-500 hover:text-avocado-900" asp-controller="Movies" asp-action="Details" asp-route-id="@Model.MovieId">@Model.Title</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink">Edit Movie</span>
</nav>

<section class="mx-auto w-full max-w-2xl" aria-labelledby="edit-movie-heading">
    <div class="card">
        <header class="mb-5 border-b border-line pb-4">
            <p class="kicker">Catalog Record</p>
            <h1 id="edit-movie-heading" class="mt-1 text-xl font-bold">Edit Movie</h1>
            <p class="mt-1 text-sm text-ink-muted">Update catalog metadata for @Model.Title.</p>
        </header>

        <form asp-controller="AdminMovies" asp-action="Edit" asp-route-id="@Model.MovieId" method="post" novalidate>
            @Html.AntiForgeryToken()

            <partial name="_MovieFormFields" model="Model" />

            <div class="flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a class="btn btn-secondary" asp-controller="AdminMovies" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

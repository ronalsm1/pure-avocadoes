@model PureAvocadoes.ViewModels.MovieFormViewModel
@{
    ViewData["Title"] = "Add Movie";
}

<nav class="mb-5 flex flex-wrap items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
    <a class="font-semibold text-avocado-500 hover:text-avocado-900" asp-controller="AdminMovies" asp-action="Index">Manage Movies</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink">Add Movie</span>
</nav>

<section class="mx-auto w-full max-w-2xl" aria-labelledby="create-movie-heading">
    <div class="card">
        <header class="mb-5 border-b border-line pb-4">
            <p class="kicker">Catalog Record</p>
            <h1 id="create-movie-heading" class="mt-1 text-xl font-bold">Add New Movie</h1>
            <p class="mt-1 text-sm text-ink-muted">Add a film record to the Pure Avocadoes catalog.</p>
        </header>

        <form asp-controller="AdminMovies" asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()

            <partial name="_MovieFormFields" model="Model" />

            <div class="flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Create Movie</button>
                <a class="btn btn-secondary" asp-controller="AdminMovies" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model PureAvocadoes.ViewModels.ReviewFormViewModel
@{
    ViewData["Title"] = "Edit Review";
}

<nav class="mb-5 flex flex-wrap items-center gap-2 text-sm text-ink-muted" aria-label="Breadcrumb">
    <a class="font-semibold text-avocado-500 hover:text-avocado-900" asp-controller="Reviews" asp-action="Mine">My Reviews</a>
    <span aria-hidden="true">/</span>
    <a class="font-semibold text-avocado-500 hover:text-avocado-900" href="/Movies/Details/@Model.MovieId">@Model.MovieTitle</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink">Edit Review</span>
</nav>

<section class="mx-auto w-full max-w-2xl" aria-labelledby="edit-review-heading">
    <div class="card">
        <header class="mb-5 border-b border-line pb-4">
            <p class="kicker">Update Rating &amp; Review</p>
            <h1 id="edit-review-heading" class="mt-1 text-xl font-bold">Edit Review</h1>
            <p class="mt-1 text-sm text-ink-muted">Reviewing <strong class="text-ink">@Model.MovieTitle</strong></p>
        </header>

        <form asp-controller="Reviews" asp-action="Edit" asp-route-id="@Model.ReviewId" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="MovieId" value="@Model.MovieId" />

            <partial name="_ReviewFormFields" model="Model" />

            <div class="flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a class="btn btn-secondary" asp-controller="Reviews" asp-action="Mine">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

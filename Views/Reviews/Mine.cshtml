@model PureAvocadoes.ViewModels.MyReviewsViewModel
@{
    ViewData["Title"] = "My Reviews";
    var userName = User.Identity?.Name ?? "Member";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "member@pureavocadoes.local";
    var userInitial = string.IsNullOrWhiteSpace(userName)
        ? "M"
        : char.ToUpperInvariant(userName.Trim()[0]).ToString();
}

@section FullBleedTop {
    <section class="border-b border-line bg-white" aria-labelledby="my-reviews-heading">
        <div class="container-page flex flex-col items-start justify-between gap-4 py-6 sm:flex-row sm:items-end">
            <div>
                <div class="flex items-center gap-3.5">
                    <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-avocado-400 text-xl font-semibold text-white" aria-hidden="true">@userInitial</span>
                    <div class="min-w-0">
                        <h1 id="my-reviews-heading" class="truncate text-xl font-bold sm:text-2xl">@userName</h1>
                        <p class="truncate text-sm tabular-nums text-ink-muted">@userEmail</p>
                    </div>
                </div>

                <div class="mt-4 flex gap-6">
                    <div>
                        <span class="block text-xl font-bold tabular-nums">@Model.TotalCount</span>
                        <span class="text-xs text-ink-muted">Reviews</span>
                    </div>
                </div>
            </div>

            <a class="flex h-10 w-10 items-center justify-center rounded-control text-ink-muted transition-colors duration-150 hover:bg-paper-muted hover:text-ink"
               href="/Account/Profile" aria-label="Account settings">
                <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <circle cx="10" cy="7" r="3.2" />
                    <path d="M4.2 16.5c.8-2.6 3-4 5.8-4s5 1.4 5.8 4" stroke-linecap="round" />
                </svg>
            </a>
        </div>
    </section>
}

<section class="pt-6" aria-label="Published reviews">
    @if (Model.HasDatabaseError)
    {
        <div class="alert alert-danger" role="alert">
            <span><strong>Error:</strong> @(Model.ErrorMessage ?? "Unable to load your reviews right now.")</span>
        </div>
    }
    else if (Model.Reviews.Count == 0)
    {
        <div class="empty-state">
            <h2>You have not written any reviews yet</h2>
            <p>Pick any film from the catalog to share a rating from 1 to 5 stars and your review.</p>
            <a class="btn btn-primary" href="/Movies">Explore Movies</a>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-4">
            @foreach (var item in Model.Reviews)
            {
                <article class="grid grid-cols-1 gap-5 rounded-card border border-line bg-paper-alt p-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
                    <a class="block max-w-[11rem] overflow-hidden rounded-card shadow-sm transition-shadow duration-150 hover:shadow-md" href="/Movies/Details/@item.Movie.MovieId" aria-label="View @item.Movie.Title details">
                        <partial name="_MoviePoster" model="item.Movie" />
                    </a>

                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2.5">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-avocado-400 text-sm font-semibold text-white" aria-hidden="true">@userInitial</span>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold">@userName</p>
                                <p class="truncate text-xs tabular-nums text-ink-muted">@userEmail</p>
                            </div>
                            <span class="ml-auto shrink-0 text-xs text-ink-muted">@(item.IsEdited ? $"Updated {item.FormattedDate}" : item.FormattedDate)</span>
                        </div>

                        <div class="mt-2 flex items-center gap-0.5" aria-label="Rated @item.Rating out of 5">
                            @for (var star = 1; star <= 5; star++)
                            {
                                var filled = star <= item.Rating;
                                <svg class="@(filled ? "text-gold-500" : "text-line-strong")" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path d="M10 1.8l2.5 5.1 5.6.8-4 4 .9 5.6L10 14.6l-5 2.7.9-5.6-4-4 5.6-.8L10 1.8z" />
                                </svg>
                            }
                        </div>

                        <p class="mt-2 text-sm leading-relaxed text-ink">@item.ReviewText</p>

                        <div class="mt-4 flex items-center gap-3 rounded-card bg-white p-3">
                            <div class="w-14 shrink-0 overflow-hidden rounded-[3px]">
                                <partial name="_MoviePoster" model="item.Movie" />
                            </div>
                            <div class="min-w-0">
                                <h2 class="truncate text-sm font-semibold">
                                    <a class="hover:text-avocado-500" href="/Movies/Details/@item.Movie.MovieId">@item.Movie.Title</a>
                                </h2>
                                <p class="text-xs text-ink-muted">
                                    <span>@item.Movie.Genre</span>
                                    <span aria-hidden="true">&middot;</span>
                                    <span class="tabular-nums">@item.Movie.ReleaseYear</span>
                                </p>
                                @if (item.Movie.HasReviews)
                                {
                                    <span class="mt-1 inline-flex items-center gap-1 text-xs font-semibold tabular-nums">
                                        <svg width="12" height="12" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                                            <path d="M16 3C11.2 3 7 10.6 7 18.2C7 24.4 10.9 29 16 29C21.1 29 25 24.4 25 18.2C25 10.6 20.8 3 16 3Z" fill="#718D43" />
                                            <circle cx="16" cy="19.5" r="4.8" fill="#D6AC55" />
                                        </svg>
                                        <span>@item.Movie.FormattedScore/5</span>
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="mt-3 flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-secondary" asp-controller="Reviews" asp-action="Edit" asp-route-id="@item.ReviewId">Edit</a>
                            <a class="btn btn-sm btn-danger-outline" asp-controller="Reviews" asp-action="Delete" asp-route-id="@item.ReviewId">Delete</a>
                            <a class="btn btn-sm btn-secondary" href="/Movies/Details/@item.Movie.MovieId">View Movie</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@model PureAvocadoes.ViewModels.ProfilePageViewModel
@{
    ViewData["Title"] = "Account Settings";
}

<section aria-label="Account settings">
    @if (Model.HasDatabaseError)
    {
        <div class="alert alert-danger" role="alert">
            <span><strong>Error:</strong> @(Model.ErrorMessage ?? "Unable to load your profile right now.")</span>
        </div>
    }
    else
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <h1 class="mb-6 font-display text-[1.75rem] font-medium uppercase tracking-[0.03em]">Account Settings</h1>

        <div class="mb-6 border-b border-line pb-5">
            <h2 class="mb-2 text-base font-semibold">Personal Information</h2>
            <p class="mb-1 text-sm">Current Name: <strong>@Model.FullName</strong></p>
            <p class="text-sm">
                Current Email: <strong class="tabular-nums">@Model.Email</strong>
            </p>
            <details class="mt-2">
                <summary class="cursor-pointer text-sm font-semibold text-avocado-500 hover:text-avocado-900">Change my details</summary>
                <div class="mt-3 rounded-card border border-line bg-white p-4">
                    <partial name="_ProfileUpdateForm" model="Model.UpdateForm" />
                </div>
            </details>
        </div>

        <div class="mb-6 border-b border-line pb-5">
            <h2 class="mb-2 text-base font-semibold">Password</h2>
            <details>
                <summary class="cursor-pointer text-sm font-semibold text-avocado-500 hover:text-avocado-900">Change my password</summary>
                <div class="mt-3 rounded-card border border-line bg-white p-4">
                    <partial name="_ChangePasswordForm" model="Model.PasswordForm" />
                </div>
            </details>
        </div>

        <div class="mb-6 border-b border-line pb-5">
            <h2 class="mb-2 text-base font-semibold">Privacy</h2>
            <p class="text-sm">
                Please make sure that you are familiar with our
                <a class="font-semibold text-avocado-500 underline underline-offset-2 hover:text-avocado-900" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>.
            </p>
        </div>

        <div>
            <h2 class="mb-2 text-base font-semibold">Profile</h2>
            <p class="mb-2 text-sm">
                <a class="font-semibold text-avocado-500 underline underline-offset-2 hover:text-avocado-900" href="/Reviews/Mine">My Reviews</a>
            </p>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-secondary">Log Out</button>
            </form>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model PureAvocadoes.ViewModels.AdminUsersIndexViewModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
        <p class="kicker">User Management</p>
        <h1 class="mt-1 font-display text-[1.75rem] font-medium uppercase tracking-[0.03em]">Manage Users</h1>
        <p class="mt-1 text-sm text-ink-muted">Review user accounts, roles, and review activity across Pure Avocadoes.</p>
    </div>
    <a class="btn btn-primary" asp-controller="AdminUsers" asp-action="Create">Add User</a>
</div>

<section class="mb-6 rounded-card border border-line bg-white p-4" aria-label="Filter users">
    <form method="get" asp-controller="AdminUsers" asp-action="Index" role="search" class="flex flex-wrap items-end gap-3">
        <div class="min-w-[14rem] flex-1">
            <label class="field-label" for="admin-user-search">Search Name or Email</label>
            <input id="admin-user-search"
                   name="search"
                   type="search"
                   class="field"
                   value="@Model.Search"
                   placeholder="Filter users by name or email..." />
        </div>

        <div class="min-w-[10rem]">
            <label class="field-label" for="admin-user-role">Role</label>
            <select id="admin-user-role" name="role" class="field">
                <option value="">All roles</option>
                <option value="User" selected="@(Model.Role == "User")">User</option>
                <option value="Admin" selected="@(Model.Role == "Admin")">Admin</option>
            </select>
        </div>

        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Role))
            {
                <a class="btn btn-secondary" asp-controller="AdminUsers" asp-action="Index">Reset</a>
            }
        </div>
    </form>
</section>

@if (Model.HasDatabaseError || !string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <section aria-label="Admin users error">
        <div class="alert alert-danger" role="alert">
            <span><strong>Error:</strong> @(Model.ErrorMessage ?? "Unable to load user accounts.")</span>
        </div>
    </section>
}
else if (Model.Users.Count == 0)
{
    <section aria-label="Empty user list">
        <div class="empty-state">
            <h2>No matching users</h2>
            <p>Adjust your search or role filter, or create a new user account.</p>
            <div class="flex flex-wrap justify-center gap-2">
                <a class="btn btn-primary" asp-controller="AdminUsers" asp-action="Create">Add User</a>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Role))
                {
                    <a class="btn btn-secondary" asp-controller="AdminUsers" asp-action="Index">Show All Users</a>
                }
            </div>
        </div>
    </section>
}
else
{
    <section aria-label="Users table">
        <div class="overflow-hidden rounded-card border border-line bg-white">
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Reviews</th>
                            <th scope="col">Joined</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var isAdminRole = string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td>
                                    <a class="font-semibold text-avocado-500 hover:text-avocado-900" asp-controller="AdminUsers" asp-action="Details" asp-route-id="@user.UserId">
                                        @user.FullName
                                    </a>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="rounded-[3px] px-2 py-0.5 text-xs font-semibold @(isAdminRole ? "bg-gold-100 text-warning-fg" : "bg-avocado-100 text-avocado-500")">@user.Role</span>
                                </td>
                                <td class="tabular-nums">@user.ReviewCount</td>
                                <td>@user.CreatedAt.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td>
                                    <div class="flex gap-2">
                                        <a class="btn btn-sm btn-secondary" asp-controller="AdminUsers" asp-action="Details" asp-route-id="@user.UserId">Details</a>
                                        <a class="btn btn-sm btn-secondary" asp-controller="AdminUsers" asp-action="Edit" asp-route-id="@user.UserId">Edit</a>
                                        <a class="btn btn-sm btn-danger-outline" asp-controller="AdminUsers" asp-action="Delete" asp-route-id="@user.UserId">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}

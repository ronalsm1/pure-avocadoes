@using PureAvocadoes.Models;
@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<section class="mx-auto w-full max-w-xl" aria-labelledby="error-heading">
    <div class="card">
        <div class="alert alert-danger" role="alert">
            <span><strong>Request failed:</strong> An unexpected error prevented Pure Avocadoes from completing this request.</span>
        </div>

        <header class="mb-5 border-b border-line pb-4">
            <p class="kicker text-danger-fg">Unexpected Error</p>
            <h1 id="error-heading" class="mt-1 text-xl font-bold">Something went wrong</h1>
            <p class="mt-1 text-sm text-ink-muted">
                Please try returning to the movie catalog or home page. No detailed server diagnostics are displayed here.
            </p>
        </header>

        @if (Model?.ShowRequestId == true)
        {
            <p class="mb-4 text-sm">
                <strong>Reference ID:</strong> <code class="rounded bg-paper-muted px-1.5 py-0.5 text-xs">@Model.RequestId</code>
            </p>
        }

        <div class="flex flex-wrap gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
            <a asp-controller="Movies" asp-action="Index" class="btn btn-secondary">Browse Movies</a>
        </div>
    </div>
</section>

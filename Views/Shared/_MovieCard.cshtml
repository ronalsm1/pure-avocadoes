@model PureAvocadoes.ViewModels.MovieCardViewModel
@* Poster tile used by every catalog grid and rail.
   Watchlist is a planned core feature (README scope, stage 2). It renders as a
   real, visibly disabled control labelled "Coming soon" rather than a live
   button that would silently discard a click (R-26). *@
<article class="flex h-full w-full flex-col">
    <a class="group relative block w-full shrink-0 overflow-hidden rounded-card shadow-sm transition-shadow duration-150 hover:shadow-md"
       href="/Movies/Details/@Model.MovieId"
       aria-label="View details for @Model.Title">
        <partial name="_MoviePoster" model="Model" />
    </a>

    <div class="flex min-h-0 flex-1 flex-col gap-0.5 pt-2.5 pb-2.5">
        <div class="flex flex-wrap items-center gap-1.5">
            @if (Model.HasReviews)
            {
                <span class="score-badge" aria-label="Avocado Score @Model.FormattedScore out of 5">
                    <svg width="14" height="14" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                        <path d="M16 3C11.2 3 7 10.6 7 18.2C7 24.4 10.9 29 16 29C21.1 29 25 24.4 25 18.2C25 10.6 20.8 3 16 3Z" fill="#718D43" />
                        <circle cx="16" cy="19.5" r="4.8" fill="#D6AC55" />
                    </svg>
                    <span>@Model.FormattedScore/5</span>
                </span>
                <span class="text-xs tabular-nums text-ink-muted">(@Model.TotalReviews)</span>
            }
            else
            {
                <span class="text-xs text-ink-faint">No reviews yet</span>
            }
        </div>

        <h3 class="text-sm font-semibold leading-snug">
            <a class="transition-colors duration-150 hover:text-avocado-500" href="/Movies/Details/@Model.MovieId">@Model.Title</a>
        </h3>

        <p class="text-xs tabular-nums text-ink-muted">Released @Model.ReleaseYear</p>
    </div>

    <button type="button"
            class="mt-auto flex min-h-8 w-full cursor-not-allowed items-center justify-center gap-1.5 rounded-control border border-line-strong bg-white px-2.5 pt-0 text-[0.6875rem] font-semibold uppercase tracking-[0.04em] text-ink-faint"
            disabled
            aria-label="Add @Model.Title to your watchlist. Coming soon">
        <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M5 3.5h10a1 1 0 0 1 1 1v12l-6-3.6-6 3.6v-12a1 1 0 0 1 1-1z" />
        </svg>
        <span>Watchlist</span>
    </button>
</article>

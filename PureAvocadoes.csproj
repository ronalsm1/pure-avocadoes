<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <!-- Tailwind assets are source, not static files served directly. -->
  <ItemGroup>
    <Content Remove="Styles\**" />
    <None Include="Styles\**" />
  </ItemGroup>

  <!--
    Compile Styles/app.css into wwwroot/css/site.css before the app is built so
    the published output always carries up-to-date CSS.
  -->
  <Target Name="BuildTailwindCss" BeforeTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\node_modules\tailwindcss\lib\cli.js')">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\node_modules\tailwindcss\lib\cli.js&quot; -i &quot;$(MSBuildProjectDirectory)\Styles\app.css&quot; -o &quot;$(MSBuildProjectDirectory)\wwwroot\css\site.css&quot; --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true" />
  </Target>

</Project>